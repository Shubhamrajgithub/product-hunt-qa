# Product Hunt API v2 token, from https://www.producthunt.com/v2/oauth/applications
# Copy this file to .env and fill in. Never commit the real .env.
PH_ACCESS_TOKEN=your_developer_or_access_token_here

# Or set the app's API key/secret and run `bun run token` to fill PH_ACCESS_TOKEN
PH_CLIENT_ID=your_api_key_here
PH_CLIENT_SECRET=your_api_secret_here

PH_API_URL=https://api.producthunt.com/v2/api/graphql
PH_WEB_URL=https://www.producthunt.com
